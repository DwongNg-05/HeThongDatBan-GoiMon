@model IEnumerable<HeThongDatBan_GoiMon.Models.MenuItem>

@{
    ViewData["Title"] = "Thực đơn món ăn";
    var categories = ViewBag.Categories as IReadOnlyList<HeThongDatBan_GoiMon.Models.MenuCategory> ?? new List<HeThongDatBan_GoiMon.Models.MenuCategory>();
    int? selectedCategory = ViewBag.SelectedCategoryId as int?;
}

<div class="text-center py-4 bg-light rounded-3 mb-4 shadow-sm border">
    <h1 class="display-6 fw-bold text-primary mb-2">🍽️ Thực Đơn Nhà Hàng</h1>
    <p class="lead text-muted mb-0">Khám phá các món ăn thơm ngon, tươi mới được chế biến theo yêu cầu</p>
</div>

<!-- Lọc theo danh mục -->
<div class="d-flex flex-wrap justify-content-center gap-2 mb-4">
    <a asp-action="Index" class="btn @(selectedCategory == null ? "btn-primary" : "btn-outline-primary") rounded-pill px-3">
        Tất cả món
    </a>
    @foreach (var cat in categories)
    {
        <a asp-action="Index" asp-route-categoryId="@cat.Id" 
           class="btn @(selectedCategory == cat.Id ? "btn-primary" : "btn-outline-primary") rounded-pill px-3">
            @cat.Name
        </a>
    }
</div>

@if (Model != null && Model.Any())
{
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
        @foreach (var item in Model)
        {
            <div class="col">
                <div class="card h-100 shadow-sm border-0 border-top border-4 border-primary">
                    <div class="card-body d-flex flex-column">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <span class="badge bg-secondary-subtle text-secondary border">@item.CategoryName</span>
                            <span class="badge bg-info-subtle text-info-emphasis border border-info-subtle">
                                ⏱ @item.PreparationTimeMinutes phút
                            </span>
                        </div>
                        <h5 class="card-title text-dark fw-bold mb-2">@item.Name</h5>
                        <p class="card-text text-muted flex-grow-1 small">
                            @(string.IsNullOrWhiteSpace(item.Description) ? "Món ngon tươi mới mỗi ngày, hương vị đậm đà hấp dẫn." : item.Description)
                        </p>
                        <div class="d-flex justify-content-between align-items-baseline mt-3 pt-3 border-top">
                            <div>
                                <span class="fs-5 fw-bold text-danger">
                                    @item.Price.ToString("N0", new System.Globalization.CultureInfo("vi-VN")) VND
                                </span>
                                <span class="text-muted small"> / @item.Unit</span>
                            </div>
                            <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">
                                ● Đang phục vụ
                            </span>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}
else
{
    <div class="alert alert-info text-center py-5 shadow-sm" role="alert">
        <h5 class="alert-heading mb-2">Chưa có món ăn nào đang bán trong mục này!</h5>
        <p class="mb-0 text-muted">Vui lòng quay lại danh mục khác hoặc chờ nhà hàng cập nhật thực đơn.</p>
    </div>
}
