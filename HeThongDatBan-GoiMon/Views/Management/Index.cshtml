@model IReadOnlyList<MenuItem>
@using System.Globalization
@{
    ViewData["Title"] = "Quản lý thực đơn";
    var culture = CultureInfo.GetCultureInfo("vi-VN");
}
<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
        <h1 class="h3">Quản lý thực đơn</h1>
        <p class="text-muted mb-0">Xin chào, <strong>@User.Identity?.Name</strong>. Chọn một món để cập nhật tên hoặc giá.</p>
    </div>
    <a asp-action="History" class="btn btn-outline-primary">Lịch sử thay đổi</a>
</div>
<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table align-middle mb-0">
            <thead class="table-light"><tr><th scope="col">Mã món</th><th scope="col">Tên món</th><th scope="col">Giá (VNĐ)</th><th scope="col"><span class="visually-hidden">Thao tác</span></th></tr></thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>#@item.Id</td><td>@item.Name</td><td>@item.Price.ToString("#,##0.##", culture)</td>
                        <td class="text-end"><a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary" aria-label="Sửa @item.Name">Chỉnh sửa</a></td>
                    </tr>
                }
                @if (Model.Count == 0)
                {
                    <tr><td colspan="4" class="text-center text-muted p-4">Chưa có món trong thực đơn.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
