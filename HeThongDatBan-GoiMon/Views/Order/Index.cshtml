@model IEnumerable<HeThongDatBan_GoiMon.Models.MenuItem>

@{
    ViewData["Title"] = "Màn hình gọi món";
    var categories = ViewBag.Categories as IReadOnlyList<HeThongDatBan_GoiMon.Models.MenuCategory> ?? new List<HeThongDatBan_GoiMon.Models.MenuCategory>();
    var currentOrder = ViewBag.CurrentOrder as HeThongDatBan_GoiMon.Models.Order;
    int? selectedCategory = ViewBag.SelectedCategoryId as int?;
    var culture = new System.Globalization.CultureInfo("vi-VN");
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h2 class="mb-1 text-primary"><i class="bi bi-cart-plus"></i> Màn hình gọi món</h2>
        <p class="text-muted mb-0">Chọn món đang bán để thêm vào Order đang mở</p>
    </div>
    <div>
        <span class="badge bg-primary fs-6 px-3 py-2">
            Phòng / Bàn: @(currentOrder?.TableName ?? "Bàn 01") | Mã: @(currentOrder?.Code ?? "ORD-001")
        </span>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="row g-4">
    <!-- CỘT TRÁI: DANH SÁCH MÓN ĐANG BÁN ĐỂ CHỌN -->
    <div class="col-lg-7">
        <div class="card shadow-sm border-0 mb-3">
            <div class="card-header bg-white py-3">
                <div class="d-flex flex-wrap gap-2">
                    <a asp-action="Index" class="btn btn-sm @(selectedCategory == null ? "btn-primary" : "btn-outline-secondary") rounded-pill">
                        Tất cả
                    </a>
                    @foreach (var cat in categories)
                    {
                        <a asp-action="Index" asp-route-categoryId="@cat.Id" 
                           class="btn btn-sm @(selectedCategory == cat.Id ? "btn-primary" : "btn-outline-secondary") rounded-pill">
                            @cat.Name
                        </a>
                    }
                </div>
            </div>
            <div class="card-body p-3">
                @if (Model != null && Model.Any())
                {
                    <div class="row row-cols-1 row-cols-md-2 g-3">
                        @foreach (var item in Model)
                        {
                            <div class="col">
                                <div class="card h-100 border shadow-none hover-shadow p-2">
                                    <div class="d-flex justify-content-between align-items-start mb-1">
                                        <h6 class="fw-bold mb-0 text-dark">@item.Name</h6>
                                        <span class="badge bg-secondary-subtle text-secondary small">@item.Unit</span>
                                    </div>
                                    <small class="text-muted text-truncate mb-2" style="max-height: 38px; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
                                        @(string.IsNullOrWhiteSpace(item.Description) ? "Món ngon phục vụ nóng hổi" : item.Description)
                                    </small>
                                    <div class="d-flex justify-content-between align-items-center mt-auto pt-2 border-top">
                                        <div>
                                            <div class="text-danger fw-bold">@item.Price.ToString("N0", culture) VND</div>
                                            <small class="text-muted">⏱ @item.PreparationTimeMinutes phút</small>
                                        </div>
                                        <form asp-action="AddItem" method="post" class="d-flex align-items-center gap-1">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="menuItemId" value="@item.Id" />
                                            <input type="number" name="quantity" value="1" min="1" max="99" class="form-control form-control-sm text-center" style="width: 50px;" />
                                            <button type="submit" class="btn btn-sm btn-outline-primary" title="Thêm vào order">
                                                + Thêm
                                            </button>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="text-center py-4 text-muted">
                        <em>Không có món ăn nào đang bán trong nhóm này.</em>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- CỘT PHẢI: ORDER ĐANG MỞ VÀ CÁC MÓN ĐÃ GỌI -->
    <div class="col-lg-5">
        <div class="card shadow-sm border-0 sticky-top" style="top: 20px;">
            <div class="card-header bg-primary text-white py-3 d-flex justify-content-between align-items-center">
                <h5 class="mb-0"><i class="bi bi-receipt"></i> Phiếu Order Hiện Tại</h5>
                <span class="badge bg-light text-primary fw-semibold">Đang mở</span>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive" style="max-height: 400px; overflow-y: auto;">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-3">Món</th>
                                <th class="text-center" style="width: 60px;">SL</th>
                                <th class="text-end" style="width: 100px;">Đơn giá</th>
                                <th class="text-end pe-3" style="width: 110px;">Thành tiền</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (currentOrder != null && currentOrder.Items.Any())
                            {
                                @foreach (var line in currentOrder.Items)
                                {
                                    <tr>
                                        <td class="ps-3">
                                            <div class="fw-bold text-dark">@line.ItemNameSnapshot</div>
                                            <small class="text-muted">ĐVT: @line.Unit</small>
                                            @if (!string.IsNullOrWhiteSpace(line.Note))
                                            {
                                                <div class="text-info small fst-italic">Note: @line.Note</div>
                                            }
                                        </td>
                                        <td class="text-center">
                                            <span class="badge bg-secondary-subtle text-secondary fs-6">@line.Quantity</span>
                                        </td>
                                        <td class="text-end text-muted small">
                                            @line.UnitPrice.ToString("N0", culture)
                                        </td>
                                        <td class="text-end pe-3 fw-bold text-danger">
                                            @line.LineTotal.ToString("N0", culture) VND
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="4" class="text-center py-4 text-muted">
                                        <em>Chưa có món nào được thêm vào order. Chọn món bên trái để gọi.</em>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="card-footer bg-light p-3 border-top">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="text-muted">Tổng số lượng:</span>
                    <span class="fw-bold">@(currentOrder?.TotalItemsCount ?? 0) phần</span>
                </div>
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <span class="fs-5 fw-bold text-dark">Tổng thành tiền:</span>
                    <span class="fs-4 fw-bold text-danger">
                        @((currentOrder?.TotalAmount ?? 0m).ToString("N0", culture)) VND
                    </span>
                </div>
                @if (currentOrder != null && currentOrder.Items.Any())
                {
                    <form asp-action="Clear" method="post" onsubmit="return confirm('Bạn có chắc muốn làm mới toàn bộ phiếu order này?');">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-outline-danger w-100 btn-sm">
                            Làm mới Order
                        </button>
                    </form>
                }
            </div>
        </div>
    </div>
</div>
