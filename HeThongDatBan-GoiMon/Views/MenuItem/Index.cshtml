@model IEnumerable<HeThongDatBan_GoiMon.Models.MenuItem>

@{
    ViewData["Title"] = "Quản lý món ăn";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="mb-1 text-primary"><i class="bi bi-card-list"></i> Danh mục món ăn</h2>
        <p class="text-muted mb-0">Quản lý danh sách món, giá bán và trạng thái phục vụ</p>
    </div>
    <div>
        <a asp-action="Create" class="btn btn-primary px-4 shadow-sm">
            + Thêm món mới
        </a>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-3" style="width: 100px;">Mã món</th>
                        <th>Tên món</th>
                        <th>Nhóm món</th>
                        <th class="text-end" style="width: 180px;">Giá bán</th>
                        <th class="text-center" style="width: 130px;">Đơn vị tính</th>
                        <th class="text-center" style="width: 160px;">Thời gian chế biến</th>
                        <th class="text-center" style="width: 140px;">Trạng thái</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-3"><span class="badge bg-light text-dark border">@item.Code</span></td>
                                <td>
                                    <div class="fw-bold text-dark">@item.Name</div>
                                    @if (!string.IsNullOrWhiteSpace(item.Description))
                                    {
                                        <small class="text-muted text-truncate d-inline-block" style="max-width: 320px;">@item.Description</small>
                                    }
                                </td>
                                <td><span class="badge bg-secondary-subtle text-secondary border">@item.CategoryName</span></td>
                                <td class="text-end fw-semibold text-danger fs-6">
                                    @item.Price.ToString("N0", new System.Globalization.CultureInfo("vi-VN")) VND
                                </td>
                                <td class="text-center">@item.Unit</td>
                                <td class="text-center">
                                    <span class="badge bg-info-subtle text-info-emphasis border border-info-subtle">
                                        ⏱ @item.PreparationTimeMinutes phút
                                    </span>
                                </td>
                                <td class="text-center">
                                    @if (item.IsActive)
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">
                                            ● Đang bán
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle px-2 py-1">
                                            Ngừng bán
                                        </span>
                                    }
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center py-5 text-muted">
                                <em>Chưa có món ăn nào trong thực đơn. Nhấn "Thêm món mới" để bắt đầu.</em>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
