@model LoginViewModel
@{
    ViewData["Title"] = "Đăng nhập";
}
<div class="row justify-content-center py-4 py-md-5">
    <div class="col-md-7 col-lg-5">
        <div class="card shadow-sm border-0">
            <div class="card-body p-4 p-md-5">
                <p class="text-uppercase text-muted small mb-2">Hệ thống đặt bàn &amp; gọi món</p>
                <h1 class="h3 mb-2">Đăng nhập quản lý</h1>
                <p class="text-muted mb-4">Sử dụng tên tài khoản hoặc số điện thoại của bạn.</p>
                <form asp-controller="Account" asp-action="Login" method="post">
                    <input asp-for="ReturnUrl" type="hidden" />
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>
                    @if (Model.LockoutRemainingSeconds is int seconds)
                    {
                        <div class="alert alert-warning" id="login-lockout" role="status" data-remaining-seconds="@seconds">
                            <p class="mb-1">Tài khoản tạm thời bị khóa do đăng nhập sai nhiều lần.</p>
                            <p class="mb-0">Vui lòng thử lại sau <strong id="lockout-countdown" role="timer">@TimeSpan.FromSeconds(seconds).ToString(@"mm\:ss")</strong>.</p>
                        </div>
                    }
                    <div class="mb-3">
                        <label asp-for="Identifier" class="form-label"></label>
                        <input asp-for="Identifier" class="form-control" autocomplete="username" autofocus maxlength="100" />
                        <span asp-validation-for="Identifier" class="text-danger small"></span>
                    </div>
                    <div class="mb-4">
                        <label asp-for="Password" class="form-label"></label>
                        <input asp-for="Password" class="form-control" autocomplete="current-password" maxlength="256" />
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>
                    <button type="submit" class="btn btn-primary w-100">Đăng nhập</button>
                </form>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/login-lockout.js" asp-append-version="true"></script>
}
